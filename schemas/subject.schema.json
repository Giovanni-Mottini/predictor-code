{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:predictor:subject:0.2.0",
  "title": "PREDICTOR subject 0.2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "cohort": {
      "enum": [
        "SANI",
        "PAZIENTI",
        "CONTROLLO PAZIENTI"
      ]
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "participant_key": {
      "type": "string",
      "minLength": 1
    },
    "source_subject_folder": {
      "type": "string",
      "minLength": 1
    },
    "clinical_metadata": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "available",
            "not_collected_by_protocol",
            "not_available_in_snapshot",
            "needs_review"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^src_[0-9a-f]{24}$"
          }
        },
        "lesion_hemisphere": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "paretic_side": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "non_paretic_side": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "dominant_hand": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "timeline_dates": {
          "type": "object",
          "propertyNames": {
            "pattern": "^T\\d+(?:_D\\d+)?$"
          },
          "additionalProperties": {
            "type": "string",
            "format": "date"
          }
        },
        "side_derivation_rule": {
          "anyOf": [
            {
              "const": "paretic_arm_contralateral_to_lesion_hemisphere"
            },
            {
              "type": "null"
            }
          ]
        },
        "hemisphere_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^src_[0-9a-f]{24}$"
              },
              "sheet": {
                "type": "string"
              },
              "cell": {
                "type": "string"
              },
              "source_value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "normalized_side": {
                "enum": [
                  "left",
                  "right",
                  null
                ]
              }
            },
            "required": [
              "source_id",
              "sheet",
              "cell",
              "source_value",
              "normalized_side"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "source_ids",
        "lesion_hemisphere",
        "paretic_side",
        "non_paretic_side",
        "dominant_hand",
        "timeline_dates",
        "side_derivation_rule",
        "hemisphere_evidence"
      ],
      "additionalProperties": false
    },
    "available_modalities": {
      "type": "array",
      "items": {
        "enum": [
          "xsens",
          "garmin",
          "motore",
          "clinical"
        ]
      }
    },
    "snapshot_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "download_completeness": {
      "const": "unknown"
    }
  },
  "required": [
    "schema_version",
    "cohort",
    "subject_id",
    "participant_key",
    "source_subject_folder",
    "clinical_metadata",
    "available_modalities",
    "snapshot_file_count",
    "download_completeness"
  ],
  "additionalProperties": false
}
