# Code-only repository. New top-level folders stay private until reviewed.
/*
!/.gitignore
!/README.txt
!/CLI_GUIDE.txt
!/CODE_MAP.txt
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/requirements-dev.txt
!/pytest.ini
!/predictor_import/
!/xsens_code/
!/shared_code/
!/docs/
!/schemas/
!/archive/
